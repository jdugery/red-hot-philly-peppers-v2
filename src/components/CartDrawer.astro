<button class="cart-trigger" type="button" data-cart-open aria-label="Open shopping cart">
  <span aria-hidden="true">Cart</span>
  <span class="cart-count" data-cart-count>0</span>
</button>

<div class="cart-backdrop" data-cart-backdrop hidden></div>
<aside class="cart-drawer" data-cart-drawer aria-hidden="true" aria-label="Shopping cart">
  <div class="cart-drawer-header">
    <div>
      <p class="cart-eyebrow">Your order</p>
      <h2>Seed cart</h2>
    </div>
    <button class="cart-close" type="button" data-cart-close aria-label="Close shopping cart">×</button>
  </div>

  <div class="cart-items" data-cart-items></div>

  <div class="cart-empty" data-cart-empty>
    <p>Your cart is empty.</p>
    <span>Add a few seed packets, then check out together.</span>
  </div>

  <div class="cart-summary" data-cart-summary hidden>
    <div><span>Subtotal</span><strong data-cart-subtotal>$0.00</strong></div>
    <p>Shipping and applicable tax are shown at checkout.</p>
    <a class="cart-checkout" href="/checkout">Checkout</a>
  </div>
</aside>

<style>
  .cart-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 10px 0 13px;
    border: 1px solid rgba(255,255,255,.5);
    border-radius: 999px;
    color: white;
    background: rgba(255,255,255,.08);
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
  }
  .cart-count {
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--red-dark);
    background: white;
    font-size: 11px;
  }
  .cart-backdrop {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(30, 18, 16, .45);
    backdrop-filter: blur(2px);
  }
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 100;
    width: min(430px, 100%);
    height: 100dvh;
    padding: 28px;
    display: flex;
    flex-direction: column;
    transform: translateX(105%);
    transition: transform 200ms ease;
    color: var(--text);
    background: var(--white);
    box-shadow: -20px 0 60px rgba(42, 20, 17, .22);
  }
  .cart-drawer.open { transform: translateX(0); }
  .cart-drawer-header { display: flex; justify-content: space-between; gap: 20px; align-items: flex-start; }
  .cart-eyebrow { margin: 0 0 6px; color: var(--red); font-size: 11px; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
  .cart-drawer h2 { margin: 0; font-family: Georgia, serif; font-size: 30px; }
  .cart-close { width: 40px; height: 40px; border: 1px solid var(--border); border-radius: 50%; background: transparent; cursor: pointer; font-size: 27px; line-height: 1; }
  .cart-items { margin: 26px 0 0; overflow: auto; }
  .cart-empty { margin: auto 0; color: var(--muted); text-align: center; }
  .cart-empty p { margin: 0 0 7px; color: var(--text); font-size: 20px; font-weight: 800; }
  .cart-empty span { font-size: 14px; }
  .cart-summary { margin-top: auto; padding-top: 22px; border-top: 1px solid var(--border); }
  .cart-summary > div { display: flex; justify-content: space-between; align-items: baseline; font-size: 18px; }
  .cart-summary strong { color: var(--red); font-size: 24px; }
  .cart-summary p { margin: 9px 0 18px; color: var(--muted); font-size: 12px; }
  .cart-checkout { min-height: 50px; display: grid; place-items: center; border-radius: 10px; color: white; background: var(--red); font-weight: 850; }
  :global(.cart-line) { padding: 16px 0; display: grid; grid-template-columns: 1fr auto; gap: 10px 18px; border-bottom: 1px solid var(--border); }
  :global(.cart-line-name) { margin: 0; font-weight: 800; }
  :global(.cart-line-meta) { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
  :global(.cart-line-price) { font-weight: 800; }
  :global(.cart-line-controls) { display: flex; align-items: center; gap: 8px; }
  :global(.cart-line-controls button) { width: 29px; height: 29px; border: 1px solid var(--border); border-radius: 7px; background: white; cursor: pointer; font-size: 16px; }
  :global(.cart-remove) { width: auto !important; padding: 0 6px; color: var(--red); border: 0 !important; background: transparent !important; font-size: 12px !important; }
  @media (max-width: 820px) { .cart-trigger { margin-left: auto; } }
  @media (max-width: 520px) { .cart-drawer { padding: 22px 20px; } }
</style>
