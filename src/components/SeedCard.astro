---
interface Props {
  name: string;
  available: boolean;
  seedPrice?: number;
  seedQuantity?: string;
  isolatedAvailable?: boolean;
  isolatedPrice?: number;
  purchaseUrl?: string;
}

const {
  name,
  available,
  seedPrice,
  seedQuantity,
  isolatedAvailable = false,
  isolatedPrice,
  purchaseUrl,
} = Astro.props;

const formattedPrice =
  typeof seedPrice === "number"
    ? new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
      }).format(seedPrice)
    : null;

const purchaseLink =
  purchaseUrl || "mailto:johnny@redhotphillypeppers.com";
---

<section class="seed-card">
  <div class="seed-card-top">
    <div>
      <p class="seed-label">Seeds</p>
      <h2>Grow {name}</h2>
    </div>

    <span
      class:list={[
        "availability-badge",
        available ? "available" : "unavailable",
      ]}
    >
      {available ? "Available" : "Unavailable"}
    </span>
  </div>

  {
    available ? (
      <>
        {(formattedPrice || seedQuantity) && (
          <div class="seed-details">
            {formattedPrice && (
              <strong class="seed-price">{formattedPrice}</strong>
            )}

            {seedQuantity && (
              <span class="seed-quantity">QTY: {seedQuantity}</span>
            )}
          </div>
        )}

        <p class="seed-note">
          Germination tested. Open pollinated unless otherwise noted.
        </p>

        {isolatedAvailable && (
          <div class="isolated-option">
            <div>
              <strong class="isolated-title">
                Isolated seeds available
              </strong>

              <span class="isolated-description">
                Optional isolated-seed upgrade
              </span>
            </div>

            {typeof isolatedPrice === "number" && (
              <strong class="isolated-price">
                +${isolatedPrice.toFixed(2)}
              </strong>
            )}
          </div>
        )}

        <a
          class="purchase-button"
          href={purchaseLink}
          target={purchaseUrl ? "_blank" : undefined}
          rel={purchaseUrl ? "noopener noreferrer" : undefined}
        >
          Purchase seeds
        </a>
      </>
    ) : (
      <>
        <p class="seed-note">
          Seeds for this variety are not currently available.
        </p>

        <a
          class="secondary-button"
          href="mailto:johnny@redhotphillypeppers.com"
        >
          Ask about future availability
        </a>
      </>
    )
  }
</section>

<style>
  .seed-card {
    margin-top: 22px;
    padding: 24px;
    border: 1px solid rgba(41, 76, 50, 0.22);
    border-radius: 16px;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.78),
        rgba(236, 230, 213, 0.88)
      );
    box-shadow: 0 14px 35px rgba(50, 40, 25, 0.08);
  }

  .seed-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
  }

  .seed-label {
    margin: 0 0 10px;
    color: var(--red);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .seed-card h2 {
    margin: 0;
    font-size: 25px;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .availability-badge {
    flex: 0 0 auto;
    padding: 7px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
  }

  .availability-badge.available {
    color: #225334;
    background: #dcebdc;
  }

  .availability-badge.unavailable {
    color: #6c6254;
    background: #e7e0d3;
  }

  .seed-details {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 22px;
  }

  .seed-price {
    color: var(--red);
    font-size: 30px;
    line-height: 1;
  }

  .seed-quantity {
    color: var(--muted);
    font-size: 14px;
  }

  .seed-note {
    margin: 16px 0 20px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .isolated-option {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    margin: 0 0 20px;
    padding: 14px 16px;
    border: 1px solid rgba(41, 76, 50, 0.2);
    border-radius: 10px;
    background: rgba(41, 76, 50, 0.07);
  }

  .isolated-option > div {
    display: grid;
    gap: 3px;
  }

  .isolated-title {
    color: var(--text);
    font-size: 15px;
  }

  .isolated-description {
    color: var(--muted);
    font-size: 13px;
  }

  .isolated-price {
    flex: 0 0 auto;
    color: var(--red);
    font-size: 18px;
  }

  .purchase-button,
  .secondary-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 50px;
    box-sizing: border-box;
    padding: 0 20px;
    border-radius: 10px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    transition:
      transform 150ms ease,
      background 150ms ease;
  }

  .purchase-button {
    color: white;
    background: var(--red);
  }

  .purchase-button:hover {
    transform: translateY(-2px);
    filter: brightness(0.94);
  }

  .secondary-button {
    color: var(--red);
    border: 1px solid var(--red);
    background: transparent;
  }

  .secondary-button:hover {
    background: rgba(163, 45, 38, 0.06);
  }

  @media (max-width: 520px) {
    .seed-card-top {
      display: block;
    }

    .availability-badge {
      display: inline-block;
      margin-top: 14px;
    }
  }
</style>