---
const { title = "Red Hot Philly Peppers" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta
      name="description"
      content="Small-batch, germination-tested specialty pepper seeds and uncommon varieties."
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/" aria-label="Red Hot Philly Peppers home">
        <img src="/images/logo.png" alt="" />
        <span>Red Hot Philly Peppers</span>
      </a>

      <nav aria-label="Main navigation">
        <a href="/peppers">Peppers</a>
        <a href="/tomatoes">Tomatoes</a>
        <a href="/tobacco">Tobacco</a>
        <a href="/about">About</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>

    <slot />

    <footer>
      <p>© {new Date().getFullYear()} Red Hot Philly Peppers</p>
      <p>Philadelphia, Pennsylvania</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --black: #241917;
    --text: #241917;
    --cream: #f7eee8;
    --white: #fffaf7;
    --red: #a32627;
    --red-dark: #861f21;
    --red-light: #c44239;
    --red-soft: #efd1ca;
    --red-pale: #faeae6;
    --green: #304638;
    --muted: #766762;
    --border: #ddc9c1;
    --shadow: 0 18px 45px rgba(77, 28, 24, 0.12);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--cream);
    color: var(--black);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  a { color: inherit; text-decoration: none; }
  main { min-height: 65vh; }

  .site-header {
    width: min(1180px, calc(100% - 40px));
    min-height: 78px;
    margin: 18px auto 0;
    padding: 8px 22px 8px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-radius: 14px;
    background: var(--red-dark);
    color: white;
    box-shadow: 0 10px 28px rgba(84, 27, 23, 0.2);
  }

  .logo { display: flex; align-items: center; gap: 12px; }
  .logo img { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; }
  .logo span { font-family: Georgia, serif; font-size: 24px; font-weight: 700; }

  .site-header nav { display: flex; gap: 24px; font-size: 14px; font-weight: 700; }
  .site-header nav a { padding: 8px 0; border-bottom: 1px solid transparent; }
  .site-header nav a:hover { border-color: rgba(255,255,255,.75); }

  footer {
    padding: 28px max(20px, calc((100% - 1160px) / 2));
    display: flex;
    justify-content: space-between;
    gap: 20px;
    background: #321719;
    color: rgba(255,255,255,.7);
    font-size: 13px;
  }
  footer p { margin: 0; }

  @media (max-width: 820px) {
    .site-header { padding: 10px 14px 14px; flex-wrap: wrap; }
    .site-header nav {
      width: 100%;
      padding-top: 10px;
      justify-content: center;
      flex-wrap: wrap;
      gap: 4px 18px;
      border-top: 1px solid rgba(255,255,255,.2);
    }
  }

  @media (max-width: 520px) {
    .site-header { width: calc(100% - 24px); margin-top: 12px; }
    .logo img { width: 50px; height: 50px; }
    .logo span { font-size: 19px; }
    .site-header nav { font-size: 12px; gap: 2px 13px; }
    footer { flex-direction: column; text-align: center; gap: 8px; }
  }
</style>
