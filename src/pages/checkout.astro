---
import MainLayout from "../layouts/MainLayout.astro";
import { env } from "cloudflare:workers";

export const prerender = false;

const production = env.SQUARE_ENV === "production";
const squareApplicationId = production ? "sq0idp-h660eM3KEKiKuZXXHJzM0A" : "sandbox-sq0idb-EzZP9_8QHEGrWN12H5FRPg";
const squareLocationId = production ? "L53B3P55TJJ5M" : "LR809HXY3TYB8";
const squareSdkUrl = production ? "https://web.squarecdn.com/v1/square.js" : "https://sandbox.web.squarecdn.com/v1/square.js";
---

<MainLayout title="Checkout | Red Hot Philly Peppers">
  <main
    class="checkout-page"
    data-square-application-id={squareApplicationId}
    data-square-location-id={squareLocationId}
    data-square-environment={production ? "production" : "sandbox"}
  >
    <div class="checkout-heading">
      <a href="/peppers">← Continue shopping</a>
      <span>{production ? "Secure checkout powered by Square" : "Square Sandbox · Test orders only"}</span>
      <h1>Checkout</h1>
      <p>One secure checkout for all of your seed packets.</p>
    </div>

    <div class="checkout-grid">
      <form id="checkout-form" class="checkout-form">
        <section>
          <p class="section-number">01</p>
          <div>
            <h2>Contact</h2>
            <div class="field-grid two-columns">
              <label>Email<input name="email" type="email" autocomplete="email" required /></label>
              <label>Phone<input name="phone" type="tel" autocomplete="tel" required /></label>
            </div>
          </div>
        </section>

        <section>
          <p class="section-number">02</p>
          <div>
            <h2>Shipping address</h2>
            <div class="field-grid">
              <label>Full name<input name="name" autocomplete="name" required /></label>
              <label>Street address<input name="addressLine1" autocomplete="address-line1" required /></label>
              <label>Apartment, suite, etc. <span>(optional)</span><input name="addressLine2" autocomplete="address-line2" /></label>
              <div class="address-row">
                <label>City<input name="city" autocomplete="address-level2" required /></label>
                <label>State<input name="state" autocomplete="address-level1" maxlength="2" placeholder="PA" required /></label>
                <label>ZIP<input name="postalCode" autocomplete="postal-code" required /></label>
              </div>
            </div>
          </div>
        </section>

        <section>
          <p class="section-number">03</p>
          <div>
            <h2>Payment</h2>
            <p class="secure-note">Card details are securely handled by Square and never touch our server.</p>
            <div id="card-container" class="card-container"></div>
            <p class="sandbox-help">Sandbox test card: 4111 1111 1111 1111 · any future expiration · CVV 111 · ZIP 94103</p>
          </div>
        </section>

        <div id="checkout-message" class="checkout-message" role="status" hidden></div>
        <button id="place-order-button" class="place-order-button" type="submit" disabled>
          {production ? "Place order" : "Place test order"}
        </button>
      </form>

      <aside class="order-card">
        <p class="order-label">Order summary</p>
        <div id="checkout-items"></div>
        <div id="checkout-empty" class="checkout-empty" hidden>
          <p>Your cart is empty.</p>
          <a href="/peppers">Browse available seeds</a>
        </div>
        <div id="checkout-totals" class="checkout-totals">
          <div><span>Subtotal</span><strong id="checkout-subtotal">$0.00</strong></div>
          <div><span>Seed packet shipping</span><strong>$4.00</strong></div>
          <div><span>Tax</span><strong>Not enabled in Sandbox</strong></div>
          <div class="checkout-total"><span>Test total</span><strong id="checkout-total">$0.00</strong></div>
        </div>
      </aside>
    </div>
  </main>
</MainLayout>

<script is:inline src={squareSdkUrl}></script>
<script is:inline type="module" src="/scripts/checkout.js"></script>

<style>
  .checkout-page { width: min(1120px, calc(100% - 40px)); margin: 0 auto; padding: 66px 0 90px; }
  .checkout-heading > a { display: inline-block; margin-bottom: 30px; color: var(--red); font-size: 13px; font-weight: 800; }
  .checkout-heading > span { width: max-content; margin-bottom: 12px; padding: 7px 10px; display: block; border-radius: 999px; color: #744c04; background: #f7df9b; font-size: 11px; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .checkout-heading h1 { margin: 0; font: 700 clamp(42px, 7vw, 76px)/.98 Georgia, serif; letter-spacing: -.045em; }
  .checkout-heading > p { margin: 16px 0 0; color: var(--muted); font-size: 18px; }
  .checkout-grid { margin-top: 48px; display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(310px, .65fr); gap: 50px; align-items: start; }
  .checkout-form { display: grid; gap: 0; }
  .checkout-form section { padding: 30px 0; display: grid; grid-template-columns: 45px 1fr; gap: 18px; border-top: 1px solid var(--border); }
  .section-number { margin: 5px 0 0; color: var(--red); font-size: 12px; font-weight: 850; }
  .checkout-form h2 { margin: 0 0 20px; font: 700 26px/1.1 Georgia, serif; }
  .field-grid { display: grid; gap: 15px; }
  .two-columns { grid-template-columns: 1fr 1fr; }
  .address-row { display: grid; grid-template-columns: 1fr 90px 120px; gap: 12px; }
  .checkout-form label { display: grid; gap: 7px; color: var(--muted); font-size: 12px; font-weight: 750; }
  .checkout-form label span { font-weight: 400; }
  .checkout-form input { width: 100%; height: 48px; padding: 0 13px; border: 1px solid var(--border); border-radius: 9px; color: var(--text); background: rgba(255,255,255,.7); font: inherit; font-size: 15px; outline: none; }
  .checkout-form input:focus { border-color: var(--red); box-shadow: 0 0 0 3px rgba(163,38,39,.1); }
  .secure-note { margin: -10px 0 16px; color: var(--muted); font-size: 13px; }
  .card-container { min-height: 90px; padding: 16px; border: 1px solid var(--border); border-radius: 10px; background: white; }
  .sandbox-help { margin: 12px 0 0; color: #795c24; font-size: 11px; line-height: 1.5; }
  .place-order-button { min-height: 54px; border: 0; border-radius: 10px; color: white; background: var(--red); cursor: pointer; font: inherit; font-weight: 850; }
  .place-order-button:disabled { cursor: not-allowed; opacity: .45; }
  .checkout-message { margin-bottom: 16px; padding: 14px 16px; border-radius: 9px; color: #702b25; background: var(--red-pale); font-size: 14px; line-height: 1.5; }
  .checkout-message.success { color: #225334; background: #dcebdc; }
  .order-card { position: sticky; top: 24px; padding: 26px; border: 1px solid var(--border); border-radius: 16px; background: rgba(255,255,255,.5); box-shadow: var(--shadow); }
  .order-label { margin: 0 0 18px; color: var(--red); font-size: 11px; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
  :global(.checkout-line) { padding: 13px 0; display: grid; grid-template-columns: 1fr auto; gap: 5px 15px; border-bottom: 1px solid var(--border); }
  :global(.checkout-line p) { margin: 0; font-size: 14px; font-weight: 800; }
  :global(.checkout-line span) { color: var(--muted); font-size: 11px; }
  :global(.checkout-line strong) { grid-row: 1 / 3; grid-column: 2; align-self: center; font-size: 14px; }
  .checkout-totals { padding-top: 16px; display: grid; gap: 11px; }
  .checkout-totals > div { display: flex; justify-content: space-between; gap: 16px; color: var(--muted); font-size: 12px; }
  .checkout-totals strong { color: var(--text); text-align: right; }
  .checkout-total { margin-top: 7px; padding-top: 16px; border-top: 1px solid var(--border); align-items: baseline; color: var(--text) !important; font-size: 17px !important; font-weight: 800; }
  .checkout-total strong { color: var(--red); font-size: 24px; }
  .checkout-empty { padding: 22px 0; text-align: center; }
  .checkout-empty p { color: var(--muted); }
  .checkout-empty a { color: var(--red); font-weight: 800; }
  @media (max-width: 820px) { .checkout-grid { grid-template-columns: 1fr; } .order-card { position: static; grid-row: 1; } }
  @media (max-width: 560px) { .checkout-page { width: calc(100% - 28px); padding-top: 42px; } .two-columns, .address-row { grid-template-columns: 1fr; } .checkout-form section { grid-template-columns: 30px 1fr; } }
</style>
