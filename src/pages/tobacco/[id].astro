---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  const tobacco = await getCollection("tobacco");

  return tobacco.map((tobacco) => ({
    params: { id: tobacco.id },
    props: { tobacco },
  }));
}

const { tobacco } = Astro.props;
const { Content } = await render(tobacco);

const galleryItems = tobacco.data.gallery ?? [];

const allImages = [
  ...(tobacco.data.image
    ? [
        {
          image: tobacco.data.image,
          caption: "",
        },
      ]
    : []),

  ...galleryItems.filter(
    (item) => item.image !== tobacco.data.image,
  ),
];

const formattedPrice =
  typeof tobacco.data.seedPrice === "number"
    ? new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
      }).format(tobacco.data.seedPrice)
    : null;
---

<MainLayout title={`${tobacco.data.name} | Red Hot Philly Peppers`}>
  <main class="tobacco-page">
    <a class="back-link" href="/tobacco">← All tobacco varieties</a>

    <section class="tobacco-hero">
      <div class="image-column">
        {
          allImages.length > 0 ? (
            <>
              <figure class="main-image-figure">
                <div class="detail-image">
                  <img
                    id="main-tobacco-image"
                    src={allImages[0].image}
                    alt={
                      allImages[0].caption ||
                      `${tobacco.data.name} tobacco`
                    }
                  />
                </div>

                <figcaption
                  id="image-caption"
                  class:list={[
                    "image-caption",
                    !allImages[0].caption && "empty",
                  ]}
                >
                  {allImages[0].caption}
                </figcaption>
              </figure>

              {allImages.length > 1 && (
                <div
                  class="thumbnail-grid"
                  aria-label={`${tobacco.data.name} image gallery`}
                >
                  {allImages.map((item, index) => (
                    <button
                      class:list={[
                        "thumbnail-button",
                        index === 0 && "active",
                      ]}
                      type="button"
                      data-image={item.image}
                      data-caption={item.caption ?? ""}
                      aria-label={`View ${tobacco.data.name} image ${index + 1}`}
                    >
                      <img
                        src={item.image}
                        alt=""
                        loading="lazy"
                      />
                    </button>
                  ))}
                </div>
              )}
            </>
          ) : (
            <div class="detail-image image-placeholder">
              <span>Photo coming soon</span>
            </div>
          )
        }
      </div>

      <div class="details-column">
        <p class="tobacco-label">Tobacco variety</p>

        <h1>{tobacco.data.name}</h1>

        <p class="description">
          {tobacco.data.description}
        </p>

        <div class="facts">
          <div class="fact-row">
            <span>Species</span>
            <strong>{tobacco.data.species}</strong>
          </div>

        
        </div>

        <section class="seed-card">
          <div class="seed-card-top">
            <div>
              <p class="seed-label">Seeds</p>
              <h2> {tobacco.data.name}</h2>
            </div>

            <span
              class:list={[
                "availability-badge",
                tobacco.data.available ? "available" : "unavailable",
              ]}
            >
              {tobacco.data.available ? "Available" : "Unavailable"}
            </span>
          </div>

          {
            tobacco.data.available ? (
              <>
                {(formattedPrice || tobacco.data.seedQuantity) && (
                  <div class="seed-details">
                    {formattedPrice && (
                      <strong class="seed-price">
                        {formattedPrice}
                      </strong>
                    )}

                    {tobacco.data.seedQuantity && (
                      <span class="seed-quantity">
                        QTY: {tobacco.data.seedQuantity}
                       </span>
                    )}
                  </div>
                )}

                <p class="seed-note">
                  Germination tested. Open pollinated unless otherwise noted.
                </p>
{
  tobacco.data.isolatedAvailable && (
    <div class="isolated-option">
      <div>
        <strong class="isolated-title">
          Isolated seeds available
        </strong>

        <span class="isolated-description">
          Optional isolated-seed upgrade
        </span>
      </div>

      {
        typeof tobacco.data.isolatedPrice === "number" && (
          <strong class="isolated-price">
            +${tobacco.data.isolatedPrice.toFixed(2)}
          </strong>
        )
      }
    </div>
  )
}
                {tobacco.data.purchaseUrl ? (
                  <a
                    class="purchase-button"
                    href={tobacco.data.purchaseUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Purchase seeds
                  </a>
                ) : (
                  <a
                    class="purchase-button"
                    href="mailto:johnny@redhotphillypeppers.com"
                  >
                    Purchase seeds
                  </a>
                )}
              </>
            ) : (
              <>
                <p class="seed-note">
                  Seeds for this variety are not currently available.
                </p>

                <a
                  class="secondary-button"
                  href="mailto:johnny@redhotphillypeppers.com"
                >
                  Ask about future availability
                </a>
              </>
            )
          }
        </section>
      </div>
    </section>

    <section class="body-content">
      <Content />
    </section>
  </main>
</MainLayout>

<script>
  const mainImage = document.querySelector(
    "#main-tobacco-image",
  ) as HTMLImageElement | null;

  const captionElement = document.querySelector(
    "#image-caption",
  ) as HTMLElement | null;

  const thumbnailButtons =
    document.querySelectorAll<HTMLButtonElement>(
      ".thumbnail-button",
    );

  thumbnailButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedImage = button.dataset.image;
      const selectedCaption = button.dataset.caption ?? "";

      if (!mainImage || !selectedImage) {
        return;
      }

      mainImage.src = selectedImage;
      mainImage.alt = selectedCaption || "Tobacco image";

      if (captionElement) {
        captionElement.textContent = selectedCaption;
        captionElement.classList.toggle(
          "empty",
          selectedCaption.length === 0,
        );
      }

      thumbnailButtons.forEach((thumbnail) => {
        thumbnail.classList.remove("active");
      });

      button.classList.add("active");
    });
  });
</script>

<style>
  .tobacco-page {
    width: min(1180px, calc(100% - 40px));
    margin: auto;
    padding: 48px 0 110px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    margin-bottom: 34px;
    color: var(--red);
    font-weight: 750;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .tobacco-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    gap: 64px;
    align-items: start;
  }

  .image-column {
    min-width: 0;
  }

  .main-image-figure {
    margin: 0;
  }

  .detail-image {
    width: 100%;
    aspect-ratio: 4 / 4.6;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: #e8e2d4;
    box-shadow: 0 18px 45px rgba(50, 40, 25, 0.1);
  }

  .detail-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .image-caption {
    min-height: 22px;
    margin: 12px 8px 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
    text-align: center;
  }

  .image-caption.empty {
    visibility: hidden;
  }

  .image-placeholder {
    display: grid;
    place-items: center;
    color: var(--muted);
  }

  .thumbnail-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-top: 12px;
  }

  .thumbnail-button {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    padding: 0;
    cursor: pointer;
    border: 2px solid transparent;
    border-radius: 10px;
    background: #e8e2d4;
    opacity: 0.72;
    transition:
      opacity 150ms ease,
      border-color 150ms ease,
      transform 150ms ease;
  }

  .thumbnail-button:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .thumbnail-button.active {
    border-color: var(--red);
    opacity: 1;
  }

  .thumbnail-button img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .details-column {
    position: sticky;
    top: 30px;
    padding-top: 6px;
  }

  .tobacco-label,
  .seed-label {
    margin: 0 0 10px;
    color: var(--red);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .details-column h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(50px, 6vw, 84px);
    line-height: 0.96;
    letter-spacing: -0.05em;
  }

  .description {
    max-width: 620px;
    margin: 26px 0 30px;
    color: var(--text);
    font-size: 20px;
    line-height: 1.62;
  }

  .facts {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.5);
  }

  .fact-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 28px;
    padding: 17px 20px;
  }

  .fact-row + .fact-row {
    border-top: 1px solid var(--border);
  }

  .fact-row span {
    color: var(--muted);
  }

  .fact-row strong {
    text-align: right;
  }

  .seed-card {
    margin-top: 22px;
    padding: 24px;
    border: 1px solid rgba(41, 76, 50, 0.22);
    border-radius: 16px;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.78),
        rgba(236, 230, 213, 0.88)
      );
    box-shadow: 0 14px 35px rgba(50, 40, 25, 0.08);
  }

  .seed-card-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: flex-start;
  }

  .seed-card h2 {
    margin: 0;
    font-size: 25px;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .availability-badge {
    flex: 0 0 auto;
    padding: 7px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
  }

  .availability-badge.available {
    color: #225334;
    background: #dcebdc;
  }

  .availability-badge.unavailable {
    color: #6c6254;
    background: #e7e0d3;
  }

  .seed-details {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 22px;
  }

  .seed-price {
    color: var(--red);
    font-size: 30px;
    line-height: 1;
  }

  .seed-quantity {
    color: var(--muted);
    font-size: 14px;
  }

  .seed-note {
    margin: 16px 0 20px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }
.isolated-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  margin: 0 0 20px;
  padding: 14px 16px;
  border: 1px solid rgba(41, 76, 50, 0.2);
  border-radius: 10px;
  background: rgba(41, 76, 50, 0.07);
}

.isolated-option > div {
  display: grid;
  gap: 3px;
}

.isolated-title {
  color: var(--text);
  font-size: 15px;
}

.isolated-description {
  color: var(--muted);
  font-size: 13px;
}

.isolated-price {
  flex: 0 0 auto;
  color: var(--red);
  font-size: 18px;
}
  .purchase-button,
  .secondary-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 50px;
    padding: 0 20px;
    border-radius: 10px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
    transition:
      transform 150ms ease,
      background 150ms ease;
  }

  .purchase-button {
    color: white;
    background: var(--red);
  }

  .purchase-button:hover {
    transform: translateY(-2px);
    filter: brightness(0.94);
  }

  .secondary-button {
    color: var(--red);
    border: 1px solid var(--red);
    background: transparent;
  }

  .secondary-button:hover {
    background: rgba(163, 45, 38, 0.06);
  }

  .body-content {
    max-width: 760px;
    margin-top: 72px;
    padding-top: 38px;
    border-top: 1px solid var(--border);
    font-size: 18px;
    line-height: 1.8;
  }

  .body-content:empty {
    display: none;
  }

  @media (max-width: 850px) {
    .tobacco-page {
      padding-top: 34px;
    }

    .tobacco-hero {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .details-column {
      position: static;
      padding-top: 0;
    }

    .details-column h1 {
      font-size: clamp(46px, 13vw, 74px);
    }

    .detail-image {
      aspect-ratio: 4 / 4.2;
    }

    .body-content {
      margin-top: 54px;
    }
  }

  @media (max-width: 520px) {
    .tobacco-page {
      width: min(100% - 28px, 1180px);
    }

    .thumbnail-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .fact-row {
      align-items: flex-start;
    }

    .fact-row strong {
      max-width: 62%;
    }

    .seed-card-top {
      display: block;
    }

    .availability-badge {
      display: inline-block;
      margin-top: 14px;
    }
  }
</style>