---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

const tomatoes = await getCollection(
  "tomatoes",
  ({ data }) => data.showOnWebsite,
);

const sortedTomatoes = [...tomatoes].sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<MainLayout title="Tomato Varieties | Red Hot Philly Peppers">
  <main class="catalog-page">
    <header class="catalog-header">
      <p class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        Tomatoes
      </p>


      <h1>Tomato Varieties</h1>

      <p class="catalog-description">
        Browse our collection of tomato seeds. All varieties are grown in the Philadelphia area and are germination tested for quality and viability.
      </p>
    </header>

    {
      sortedTomatoes.length > 0 ? (
        <section class="variety-grid" aria-label="Tomato varieties">
          {sortedTomatoes.map((tomato) => (
            <article class="variety-card">
              <a
                class="image-link"
                href={`/tomatoes/${tomato.id}`}
                aria-label={`View ${tomato.data.name}`}
              >
                {tomato.data.image ? (
                  <img
                    src={tomato.data.image}
                    alt={`${tomato.data.name} tomato`}
                    loading="lazy"
                  />
                ) : (
                  <div class="image-placeholder">
                    <span>Photo coming soon</span>
                  </div>
                )}
              </a>

              <div class="tomato-card-content">
                <div class="card-heading">
                  <h2>
                    <a href={`/tomatoes/${tomato.id}`}>
                      {tomato.data.name}
                    </a>
                  </h2>

                  {tomato.data.available && (
                    <span class="availability">Seeds available</span>
                  )}
                </div>

                {tomato.data.species && (
                  <p class="species">
  {tomato.data.species}
  {tomato.data.type && <> • {tomato.data.type}</>}
</p>
                )}

            

                <p class="description">
                  {tomato.data.description}
                </p>

                <a class="view-link" href={`/tomatoes/${tomato.id}`}>
                  View variety →
                </a>
              </div>
            </article>
          ))}
        </section>
      ) : (
        <p class="empty-message">Tomato varieties are coming soon.</p>
      )
    }
  </main>
</MainLayout>

<style>
  .catalog-page {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 54px 0 110px;
  }

  .catalog-header {
    max-width: 760px;
    margin-bottom: 44px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 38px;
    color: var(--muted);
    font-size: 14px;
  }

  .breadcrumb a {
    color: var(--text);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--red);
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--red);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .catalog-header h1 {
    margin: 0;
    font-size: clamp(52px, 8vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .catalog-description {
    max-width: 680px;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 20px;
    line-height: 1.65;
  }

  .variety-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding-top: 34px;
    border-top: 1px solid var(--border);
  }

  .variety-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.52);
    box-shadow: 0 12px 32px rgba(50, 40, 25, 0.06);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .variety-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(50, 40, 25, 0.1);
  }

  .image-link {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #e8e2d4;
  }

  .image-link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .variety-card:hover .image-link img {
    transform: scale(1.025);
  }

  .image-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: var(--muted);
    font-size: 14px;
  }

  .tomato-card-content {
  padding: 20px;
}

  .card-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
  }

 .card-heading h2 {
  margin: 0;
  font-size: 20px;
  line-height: 1.12;
  letter-spacing: -0.025em;
}

  .card-heading h2 a {
    color: var(--text);
    text-decoration: none;
  }

  .card-heading h2 a:hover {
    color: var(--red);
  }

  .availability {
    flex: 0 0 auto;
    padding: 6px 8px;
    border-radius: 999px;
    color: #225334;
    background: #dcebdc;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .species {
  margin: 8px 0 14px;
  color: var(--muted);
  font-size: 14px;
  font-style: italic;
  line-height: 1.4;
}



  .description {
  margin: 0 0 16px;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.55;
}

  .view-link {
    color: var(--red);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  .view-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .empty-message {
    padding-top: 34px;
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .variety-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .catalog-page {
      width: min(100% - 28px, 1180px);
      padding-top: 34px;
    }

    .catalog-header {
      margin-bottom: 32px;
    }

    .breadcrumb {
      margin-bottom: 28px;
    }

    .catalog-header h1 {
      font-size: clamp(48px, 16vw, 68px);
    }

    .catalog-description {
      font-size: 18px;
    }

    .variety-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
