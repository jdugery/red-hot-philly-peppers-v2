---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

const entries = await getCollection("info");
const { Content } = await render(entries[0]);
---

<MainLayout title="FAQ & Info | Red Hot Philly Peppers">
  <main class="info-page">
    <header>
      <p class="eyebrow">Good to know</p>
      <h1>FAQ &amp; Info</h1>
    </header>

    <article class="info-content">
      <Content />
    </article>
  </main>
</MainLayout>

<style>
  .info-page {
    width: min(900px, calc(100% - 40px));
    min-height: 65vh;
    margin: 0 auto;
    padding: 78px 0 120px;
  }

  header {
    padding-bottom: 38px;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 16px;
    color: var(--red);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(52px, 8vw, 86px);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .info-content {
    max-width: 760px;
    padding-top: 34px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.75;
  }

  .info-content :global(h2) {
    margin: 44px 0 12px;
    color: var(--black);
    font-family: Georgia, serif;
    font-size: 32px;
    line-height: 1.15;
  }

  .info-content :global(h3) {
    margin: 30px 0 8px;
    color: var(--black);
    font-size: 21px;
  }

  .info-content :global(p),
  .info-content :global(ul),
  .info-content :global(ol) {
    margin: 0 0 20px;
  }

  .info-content :global(a) {
    color: var(--red-dark);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 520px) {
    .info-page {
      width: min(100% - 28px, 900px);
      padding: 58px 0 90px;
    }
  }
</style>
