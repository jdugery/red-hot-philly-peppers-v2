---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";

const homeEntries = await getCollection("home");
const home = homeEntries[0].data;

const peppers = await getCollection(
  "peppers",
  ({ data }) => data.showOnWebsite,
);

const featuredPeppers = [...peppers]
  .filter((pepper) => pepper.data.image)
  .slice(0, 3);
---

<MainLayout title="Red Hot Philly Peppers">
  <main>
    <section class="home-hero">
      <div class="home-hero-copy">
        <p class="eyebrow">Philadelphia grown</p>

        <h1>Rare varieties.<br />Grown locally.</h1>

        <p class="home-hero-description">
          Specialty pepper, tomato, and tobacco seeds grown in small batches
          in the Philadelphia area.
        </p>

        <nav class="home-category-links" aria-label="Browse collections">
          <a href="/peppers">Peppers <span>→</span></a>
          <a href="/tomatoes">Tomatoes <span>→</span></a>
          <a href="/tobacco">Tobacco <span>→</span></a>
        </nav>
      </div>

      <div class="hero-image">
        <img
          src="/images/hero.jpg"
          alt="Red Hot Philly Peppers"
        />
      </div>
    </section>

    <section class="home-about" id="about">
      <p class="eyebrow">About the garden</p>
      <h2>{home.aboutTitle}</h2>
      <p>{home.aboutText}</p>
    </section>

    {
      featuredPeppers.length > 1 && (
        <section class="latest-varieties">
          <div class="section-heading">
            <div>
              <p class="eyebrow">From the garden</p>
              <h2>Featured varieties</h2>
            </div>

            <a href="/peppers">View all peppers →</a>
          </div>

          <div class="featured-grid">
            {featuredPeppers.map((pepper) => (
              <a class="featured-card" href={`/peppers/${pepper.id}`}>
                <div class="featured-card-image">
                  <img
                    src={pepper.data.image}
                    alt={pepper.data.name}
                    loading="lazy"
                  />
                </div>

                <div class="featured-card-content">
                  <h3>{pepper.data.name}</h3>
                  <span>View →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="home-contact" id="contact">
      <div>
        <p class="eyebrow">Stay connected</p>
        <h2>{home.contactTitle}</h2>
        <p>{home.contactText}</p>
        <div class="social-links">
  <a
    href="https://instagram.com/redhotphillypeppersfarm"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Instagram"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.5" cy="6.5" r="1"></circle>
    </svg>
  </a>

  <a
    href="https://www.facebook.com/profile.php?id=61592659442077"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Facebook"
  >
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.6 1.6-1.6h1.7V4.8c-.3 0-1.3-.1-2.4-.1-2.4 0-4.1 1.5-4.1 4.3V11H8v3h2.6v8h2.9z"/>
    </svg>
  </a>
</div>
      </div>

      <a href="mailto:johnny@redhotphillypeppers.com">
        Contact us →
      </a>
    </section>
  </main>
</MainLayout>

<style>
  .social-links {
  display: flex;
  gap: 18px;
  margin-top: 28px;
}

.social-links a {
  width: 62px;
  height: 62px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 999px;
  color: rgba(255,255,255,.85);
  text-decoration: none;
  transition: all .2s ease;
}

.social-links a:hover {
  background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.4);
  color: white;
  transform: translateY(-3px);
}

.social-links svg {
  width: 32px;
  height: 32px;
}
  .eyebrow {
    margin: 0 0 14px;
    color: var(--red);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home-hero {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 56px 0 64px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
    align-items: center;
    gap: 68px;
  }

  .home-hero-copy h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(66px, 8vw, 116px);
    line-height: 0.88;
    letter-spacing: -0.07em;
  }

  .home-hero-description {
    max-width: 620px;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: 20px;
    line-height: 1.55;
  }

  .home-category-links {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .home-category-links a {
    min-height: 48px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 22px;
    color: var(--text);
    border: 1px solid rgba(181, 43, 43, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.38);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .home-category-links a:hover {
    transform: translateY(-2px);
    border-color: rgba(181, 43, 43, 0.5);
    background: rgba(255, 255, 255, 0.68);
  }

  .home-category-links span {
    color: var(--red);
  }

  .hero-image {
    width: 100%;
    max-width: 430px;
    justify-self: end;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
  }

  .hero-image img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .latest-varieties {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 60px 0 90px;
    border-top: 1px solid var(--border);
  }

  .home-about {
    padding: 88px max(20px, calc((100% - 900px) / 2));
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: rgba(255, 250, 247, 0.48);
    text-align: center;
  }

  .home-about h2 {
    margin: 0;
    font-size: clamp(42px, 5vw, 66px);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .home-about > p:last-child {
    max-width: 760px;
    margin: 24px auto 0;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.7;
  }

  .section-heading {
    margin-bottom: 28px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(42px, 5vw, 66px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .section-heading > a {
    color: var(--red);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .featured-card {
    overflow: hidden;
    color: inherit;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.36);
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(50, 40, 25, 0.1);
  }

  .featured-card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgba(240, 212, 206, 0.28);
  }

  .featured-card-image img {
    width: 100%;
    height: 100%;
    padding: 16px;
    display: block;
    object-fit: contain;
    transition: transform 200ms ease;
  }

  .featured-card:hover img {
    transform: scale(1.035);
  }

  .featured-card-content {
    padding: 18px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .featured-card-content h3 {
    margin: 0;
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .featured-card-content > span {
    flex-shrink: 0;
    color: var(--red);
    font-size: 13px;
    font-weight: 800;
  }

  .home-contact {
    padding: 76px max(20px, calc((100% - 1180px) / 2));
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    background: var(--red-dark);
  }

  .home-contact div {
    max-width: 720px;
  }

  .home-contact .eyebrow {
    color: rgba(255, 255, 255, 0.68);
  }

  .home-contact h2 {
    margin: 0;
    color: white;
    font-size: clamp(40px, 6vw, 68px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .home-contact p:not(.eyebrow) {
    max-width: 620px;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.76);
    font-size: 18px;
    line-height: 1.6;
  }

  .home-contact > a {
    flex-shrink: 0;
    color: white;
    font-size: 15px;
    font-weight: 850;
    text-decoration: none;
  }

  @media (max-width: 850px) {
    .home-hero {
      grid-template-columns: 1fr;
      gap: 44px;
      padding-top: 44px;
    }

    .hero-image {
      width: min(100%, 500px);
      justify-self: start;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .home-contact {
      align-items: flex-start;
      flex-direction: column;
    }

    .home-about {
      padding-top: 70px;
      padding-bottom: 70px;
    }
  }

  @media (max-width: 520px) {
    .home-hero,
    .latest-varieties {
      width: min(100% - 28px, 1180px);
    }

    .home-hero {
      padding: 36px 0 52px;
    }

    .home-hero-copy h1 {
      font-size: clamp(58px, 18vw, 78px);
    }

    .home-hero-description {
      font-size: 18px;
    }

    .home-category-links {
      flex-direction: column;
    }

    .home-category-links a {
      width: 100%;
      justify-content: space-between;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .latest-varieties {
      padding: 50px 0 70px;
    }

    .home-contact {
      padding: 64px 20px;
    }
  }
</style>
