---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";

const homeEntries = await getCollection("home");
const home = homeEntries[0].data;
const peppers = await getCollection("peppers", ({ data }) => data.showOnWebsite);
const featuredPeppers = [...peppers].filter((pepper) => pepper.data.image).slice(0, 3);
---

<MainLayout title="Red Hot Philly Peppers">
  <main>
    <section class="home-hero">
      <div class="hero-copy">
        <h1>Specialty pepper<br />seeds &amp; more.</h1>
        <p>{home.description}</p>
        <a class="primary-link" href="/peppers">Browse pepper seeds <span>→</span></a>
      </div>
      <img class="hero-photo" src="/images/hero.jpg" alt="A colorful harvest of specialty peppers" />
    </section>

    {featuredPeppers.length > 1 && (
      <section class="featured">
        <div class="section-heading">
          <h2>Featured varieties</h2>
          <a href="/peppers">All peppers →</a>
        </div>
        <div class="featured-grid">
          {featuredPeppers.map((pepper) => (
            <a class="featured-card" href={`/peppers/${pepper.id}`}>
              <img src={pepper.data.image} alt={pepper.data.name} loading="lazy" />
              <div><h3>{pepper.data.name}</h3><span>View variety →</span></div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="browse">
      <div>
        <h2>More from the garden</h2>
        <p>Explore the full collection of specialty seeds.</p>
      </div>
      <nav aria-label="Browse seed collections">
        <a href="/tomatoes"><span>Tomatoes</span><b>→</b></a>
        <a href="/tobacco"><span>Tobacco</span><b>→</b></a>
        <a href="/about"><span>About the garden</span><b>→</b></a>
      </nav>
    </section>

    <section class="home-contact" id="contact">
      <div>
        <h2>{home.contactTitle}</h2>
        <p>{home.contactText}</p>
      </div>
      <div class="contact-options-v2" style="display:flex;align-items:flex-start;gap:52px;flex-wrap:wrap;">
        <div class="email-group-v2" style="display:grid;align-content:start;gap:12px;">
          <span style="color:rgba(255,255,255,.7);font-size:13px;font-weight:700;white-space:nowrap;">Have a question?</span>
          <a style="width:max-content;padding-bottom:5px;border-bottom:1px solid rgba(255,255,255,.5);font-size:14px;font-weight:800;" href="mailto:johnny@redhotphillypeppers.com">Email us →</a>
        </div>
        <div class="social-group-v2" style="display:grid;align-content:start;gap:12px;">
          <span style="color:rgba(255,255,255,.7);font-size:13px;font-weight:700;white-space:nowrap;">Connect with us</span>
          <div class="social-icons-v2" style="display:flex;flex-direction:row;align-items:center;gap:12px;">
            <a
              class="social-link"
              style="width:42px;height:42px;padding:0;display:grid;place-items:center;border:1px solid rgba(255,255,255,.4);border-radius:50%;"
              href="https://instagram.com/redhotphillypeppersfarm"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Red Hot Philly Peppers on Instagram"
            >
              <svg style="width:22px;height:22px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
            <a
              class="social-link"
              style="width:42px;height:42px;padding:0;display:grid;place-items:center;border:1px solid rgba(255,255,255,.4);border-radius:50%;"
              href="https://www.facebook.com/profile.php?id=61592659442077"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Red Hot Philly Peppers on Facebook"
            >
              <svg style="width:22px;height:22px;" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.6 1.6-1.6h1.7V4.8c-.3 0-1.3-.1-2.4-.1-2.4 0-4.1 1.5-4.1 4.3V11H8v3h2.6v8h2.9z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<style is:global>
  .home-hero {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    padding: 54px 0 64px;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(340px, .8fr);
    align-items: center;
    gap: clamp(44px, 7vw, 84px);
  }
  .hero-copy h1 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(58px, 7vw, 94px);
    font-weight: 800;
    line-height: .94;
    letter-spacing: -.06em;
  }
  .hero-copy > p { margin: 26px 0 0; color: var(--muted); font-size: 20px; line-height: 1.55; }
  .primary-link {
    min-height: 50px;
    margin-top: 30px;
    padding: 0 20px;
    display: inline-flex;
    align-items: center;
    gap: 30px;
    border-radius: 8px;
    background: var(--red-dark);
    color: white;
    font-size: 14px;
    font-weight: 800;
  }
  .hero-photo { width: 100%; height: 470px; display: block; border-radius: 16px; object-fit: cover; box-shadow: var(--shadow); }

  .featured { width: min(1120px, calc(100% - 40px)); margin: 0 auto; padding: 58px 0 80px; border-top: 1px solid var(--border); }
  .section-heading { margin-bottom: 28px; display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .section-heading h2, .browse h2, .home-contact h2 { margin: 0; font-family: Georgia, serif; font-weight: 500; letter-spacing: -.035em; }
  .section-heading h2 { font-size: clamp(38px, 5vw, 56px); }
  .section-heading > a { color: var(--red-dark); font-size: 14px; font-weight: 800; }
  .featured-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .featured-card { overflow: hidden; border: 1px solid var(--border); border-radius: 12px; background: rgba(255,255,255,.45); }
  .featured-card img { width: 100%; aspect-ratio: 4/3; display: block; object-fit: cover; background: var(--red-pale); }
  .featured-card div { padding: 18px; display: flex; align-items: end; justify-content: space-between; gap: 16px; }
  .featured-card h3 { margin: 0; font-family: Georgia, serif; font-size: 21px; line-height: 1.15; }
  .featured-card span { flex-shrink: 0; color: var(--red-dark); font-size: 12px; font-weight: 800; }

  .browse { padding: 64px max(20px, calc((100% - 1120px)/2)); display: grid; grid-template-columns: .8fr 1.2fr; gap: 80px; background: #ead9d1; }
  .browse h2 { font-size: clamp(36px, 4vw, 50px); }
  .browse p { margin: 14px 0 0; color: var(--muted); line-height: 1.5; }
  .browse nav { display: grid; }
  .browse nav a { padding: 18px 0; display: flex; justify-content: space-between; border-bottom: 1px solid rgba(134,31,33,.22); font-weight: 800; }
  .browse nav a:first-child { border-top: 1px solid rgba(134,31,33,.22); }
  .browse nav b { color: var(--red-dark); }

  .home-contact { padding: 64px max(20px, calc((100% - 1120px)/2)); display: flex; align-items: end; justify-content: space-between; gap: 50px; background: var(--red-dark); color: white; }
  .home-contact h2 { color: white; font-size: clamp(40px, 5vw, 58px); }
  .home-contact p { max-width: 620px; margin: 16px 0 0; color: rgba(255,255,255,.72); font-size: 18px; line-height: 1.55; }
  .contact-options-v2 { display: flex; align-items: flex-start; gap: 52px; }
  .email-group-v2, .social-group-v2 { display: grid; align-content: start; gap: 12px; }
  .email-group-v2 > span, .social-group-v2 > span { color: rgba(255,255,255,.7); font-size: 13px; font-weight: 700; white-space: nowrap; }
  .email-group-v2 > a { width: max-content; padding-bottom: 5px; border-bottom: 1px solid rgba(255,255,255,.5); font-size: 14px; font-weight: 800; }
  .social-icons-v2 { display: flex !important; flex-direction: row !important; align-items: center; gap: 12px; }
  .contact-options-v2 .social-link {
    width: 42px;
    height: 42px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.4);
    border-radius: 50%;
  }
  .contact-options-v2 .social-link:hover { background: rgba(255,255,255,.1); border-color: white; }
  .contact-options-v2 .social-link svg { width: 22px; height: 22px; }

  @media (max-width: 820px) {
    .home-hero { grid-template-columns: 1fr; gap: 36px; }
    .hero-photo { height: min(80vw, 520px); }
    .featured-grid { grid-template-columns: 1fr; }
    .browse { grid-template-columns: 1fr; gap: 30px; }
    .home-contact { align-items: flex-start; flex-direction: column; }
    .contact-options-v2 { gap: 36px; }
  }
  @media (max-width: 520px) {
    .home-hero, .featured { width: calc(100% - 28px); }
    .home-hero { padding: 42px 0 52px; }
    .hero-copy h1 { font-size: clamp(50px, 16vw, 68px); }
    .hero-copy > p { font-size: 18px; }
    .hero-photo { height: 110vw; max-height: 500px; }
    .section-heading { align-items: flex-start; flex-direction: column; gap: 10px; }
    .browse, .home-contact { padding-top: 54px; padding-bottom: 54px; }
    .contact-options-v2 { width: 100%; justify-content: space-between; }
  }
</style>
