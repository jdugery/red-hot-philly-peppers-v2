---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";

const homeEntries = await getCollection("home");
const home = homeEntries[0].data;

const peppers = await getCollection(
  "peppers",
  ({ data }) => data.showOnWebsite,
);

const featuredPeppers = [...peppers]
  .filter((pepper) => pepper.data.image)
  .slice(0, 3);
---

<MainLayout title="Red Hot Philly Peppers">
  <main>
    <section class="home-hero">
      <div class="home-hero-copy">
        <h1>
          Specialty pepper<br />
          seeds &amp; more.
        </h1>

        <p class="home-hero-description">
          {home.description}
        </p>

      </div>

      <div class="hero-image">
        <img
          src="/images/hero.jpg"
          alt="Red Hot Philly Peppers"
        />
      </div>
    </section>

    {
      featuredPeppers.length > 1 && (
        <section class="latest-varieties">
          <div class="section-heading">
            <div>
              <h2>Featured varieties</h2>
            </div>

            <a href="/peppers">View all peppers →</a>
          </div>

          <div class="featured-grid">
            {featuredPeppers.map((pepper) => (
              <a class="featured-card" href={`/peppers/${pepper.id}`}>
                <div class="featured-card-image">
                  <img
                    src={pepper.data.image}
                    alt={pepper.data.name}
                    loading="lazy"
                  />
                </div>

                <div class="featured-card-content">
                  <h3>{pepper.data.name}</h3>
                  <span>View →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="home-contact" id="contact">
      <div>
        <h2>{home.contactTitle}</h2>
        <p>{home.contactText}</p>
        <div class="social-links">
  <a
    href="https://instagram.com/redhotphillypeppersfarm"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Instagram"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.5" cy="6.5" r="1"></circle>
    </svg>
  </a>

  <a
    href="https://www.facebook.com/profile.php?id=61592659442077"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Facebook"
  >
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.6 1.6-1.6h1.7V4.8c-.3 0-1.3-.1-2.4-.1-2.4 0-4.1 1.5-4.1 4.3V11H8v3h2.6v8h2.9z"/>
    </svg>
  </a>
</div>
      </div>

      <a href="mailto:johnny@redhotphillypeppers.com">
        Contact us →
      </a>
    </section>
  </main>
</MainLayout>

<style>
  .social-links {
  display: flex;
  gap: 18px;
  margin-top: 28px;
}

.social-links a {
  width: 62px;
  height: 62px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 999px;
  color: rgba(255,255,255,.85);
  text-decoration: none;
  transition: all .2s ease;
}

.social-links a:hover {
  background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.4);
  color: white;
  transform: translateY(-3px);
}

.social-links svg {
  width: 32px;
  height: 32px;
}
  .eyebrow {
    margin: 0 0 14px;
    color: var(--red);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home-hero {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 56px 0 64px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
    align-items: center;
    gap: 68px;
  }

  .home-hero-copy h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(66px, 8vw, 116px);
    line-height: 0.88;
    letter-spacing: -0.07em;
  }

  .home-hero-description {
    max-width: 620px;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: 20px;
    line-height: 1.55;
  }

  .home-category-links {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .home-category-links a {
    min-height: 48px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 22px;
    color: var(--text);
    border: 1px solid rgba(181, 43, 43, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.38);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .home-category-links a:hover {
    transform: translateY(-2px);
    border-color: rgba(181, 43, 43, 0.5);
    background: rgba(255, 255, 255, 0.68);
  }

  .home-category-links span {
    color: var(--red);
  }

  .hero-image {
    width: 100%;
    max-width: 430px;
    justify-self: end;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
  }

  .hero-image img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .latest-varieties {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 60px 0 90px;
    border-top: 1px solid var(--border);
  }

  .section-heading {
    margin-bottom: 28px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(42px, 5vw, 66px);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .section-heading > a {
    color: var(--red);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .featured-card {
    overflow: hidden;
    color: inherit;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.36);
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(50, 40, 25, 0.1);
  }

  .featured-card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgba(240, 212, 206, 0.28);
  }

  .featured-card-image img {
    width: 100%;
    height: 100%;
    padding: 16px;
    display: block;
    object-fit: contain;
    transition: transform 200ms ease;
  }

  .featured-card:hover img {
    transform: scale(1.035);
  }

  .featured-card-content {
    padding: 18px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .featured-card-content h3 {
    margin: 0;
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .featured-card-content > span {
    flex-shrink: 0;
    color: var(--red);
    font-size: 13px;
    font-weight: 800;
  }

  .home-contact {
    padding: 76px max(20px, calc((100% - 1180px) / 2));
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    background: var(--red-dark);
  }

  .home-contact div {
    max-width: 720px;
  }

  .home-contact .eyebrow {
    color: rgba(255, 255, 255, 0.68);
  }

  .home-contact h2 {
    margin: 0;
    color: white;
    font-size: clamp(40px, 6vw, 68px);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .home-contact p:not(.eyebrow) {
    max-width: 620px;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.76);
    font-size: 18px;
    line-height: 1.6;
  }

  .home-contact > a {
    flex-shrink: 0;
    color: white;
    font-size: 15px;
    font-weight: 850;
    text-decoration: none;
  }

  @media (max-width: 850px) {
    .home-hero {
      grid-template-columns: 1fr;
      gap: 44px;
      padding-top: 44px;
    }

    .hero-image {
      width: min(100%, 500px);
      justify-self: start;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .home-contact {
      align-items: flex-start;
      flex-direction: column;
    }

  }

  @media (max-width: 520px) {
    .home-hero,
    .latest-varieties {
      width: min(100% - 28px, 1180px);
    }

    .home-hero {
      padding: 36px 0 52px;
    }

    .home-hero-copy h1 {
      font-size: clamp(58px, 18vw, 78px);
    }

    .home-hero-description {
      font-size: 18px;
    }

    .home-category-links {
      flex-direction: column;
    }

    .home-category-links a {
      width: 100%;
      justify-content: space-between;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .latest-varieties {
      padding: 50px 0 70px;
    }

    .home-contact {
      padding: 64px 20px;
    }
  }

  /* Homepage layout: structured, colorful, and easy to scan. */
  .home-hero {
    width: min(1180px, calc(100% - 40px));
    height: auto;
    min-height: 500px;
    margin: 0 auto 56px;
    padding: 32px 0 40px;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(320px, 0.75fr);
    align-items: center;
    gap: clamp(40px, 5vw, 64px);
    overflow: visible;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .hero-image {
    width: 100%;
    max-width: 400px;
    height: 500px;
    min-height: 0;
    margin: 0;
    justify-self: end;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
  }

  .home-hero-copy {
    position: static;
    width: 100%;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-radius: 0;
    background: transparent;
    color: var(--black);
    box-shadow: none;
    transform: none;
  }

  .home-hero-copy h1,
  .home-hero-copy .home-hero-description {
    color: var(--black);
  }

  .home-hero-copy h1 {
    max-width: 760px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(58px, 6.2vw, 88px);
    font-weight: 800;
    line-height: 0.93;
    letter-spacing: -0.065em;
  }

  .home-hero-description {
    margin-top: 28px;
    color: var(--muted) !important;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.5;
    opacity: 1;
  }


  .home-category-links {
    margin-top: 30px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .home-category-links a {
    min-height: 48px;
    padding: 0 14px;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    color: white;
  }

  .home-category-links a:hover {
    transform: none;
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.14);
  }

  .home-category-links span {
    color: white;
  }

  .latest-varieties {
    padding-top: 52px;
  }

  .featured-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: none;
    gap: 20px;
  }

  .featured-card {
    position: static;
    min-height: 0;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.36);
  }

  .featured-card:first-child {
    grid-row: auto;
  }

  .featured-card-image,
  .featured-card:first-child .featured-card-image {
    height: auto;
    aspect-ratio: 4 / 3;
  }

  .featured-card-image img {
    height: 100%;
    padding: 16px;
    object-fit: contain;
  }

  .featured-card-content {
    position: static;
    padding: 18px;
    border-radius: 0;
    background: transparent;
    backdrop-filter: none;
  }

  @media (max-width: 850px) {
    .home-hero {
      height: auto;
      min-height: auto;
      margin-top: 30px;
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-image {
      width: 100%;
      max-width: 560px;
      height: min(92vw, 600px);
      min-height: 0;
      margin: 0;
      justify-self: start;
      border-radius: 18px;
      grid-row: 2;
    }

    .home-hero-copy {
      grid-row: 1;
    }

    .featured-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .featured-card:first-child {
      grid-row: auto;
    }

  }

  @media (max-width: 520px) {
    .home-hero,
    .latest-varieties {
      width: min(100% - 28px, 1180px);
    }

    .home-hero-copy {
      padding: 0;
    }

    .home-hero-copy h1 {
      font-size: clamp(54px, 16vw, 76px);
    }

    .home-category-links {
      grid-template-columns: 1fr;
    }

    .home-category-links a {
      width: 100%;
    }
  }
</style>
