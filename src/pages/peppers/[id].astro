---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import SeedCard from "../../components/SeedCard.astro";

export async function getStaticPaths() {
  const peppers = await getCollection(
    "peppers",
    ({ data }) => data.showOnWebsite,
  );

  return peppers.map((pepper) => ({
    params: { id: pepper.id },
    props: { pepper },
  }));
}

const { pepper } = Astro.props;
const { Content } = await render(pepper);

const galleryItems = pepper.data.gallery ?? [];

const allImages = [
  ...(pepper.data.image
    ? [
        {
          image: pepper.data.image,
          caption: "",
        },
      ]
    : []),

  ...galleryItems.filter(
    (item) => item.image !== pepper.data.image,
  ),
];
---

<MainLayout title={`${pepper.data.name} | Red Hot Philly Peppers`}>
  <main class="pepper-page">
    <a class="back-link" href="/peppers">
      ← All pepper varieties
    </a>

    <section class="pepper-hero">
      <div class="image-column">
        {
          allImages.length > 0 ? (
            <>
              <figure class="main-image-figure">
                <div class="detail-image">
  <img
    id="main-pepper-image"
    class="clickable-main-image"
    src={allImages[0].image}
    alt={
      allImages[0].caption ||
      `${pepper.data.name} pepper`
    }
  />
</div>

                <figcaption
                  id="image-caption"
                  class:list={[
                    "image-caption",
                    !allImages[0].caption && "empty",
                  ]}
                >
                  {allImages[0].caption}
                </figcaption>
              </figure>

              {allImages.length > 1 && (
                <div
                  class="thumbnail-grid"
                  aria-label={`${pepper.data.name} image gallery`}
                >
                  {allImages.map((item, index) => (
                    <button
                      class:list={[
                        "thumbnail-button",
                        index === 0 && "active",
                      ]}
                      type="button"
                      data-image={item.image}
                      data-caption={item.caption ?? ""}
                      aria-label={`View ${pepper.data.name} image ${index + 1}`}
                    >
                      <img
                        src={item.image}
                        alt=""
                        loading="lazy"
                      />
                    </button>
                  ))}
                </div>
              )}
            </>
          ) : (
            <div class="detail-image image-placeholder">
              <span>Photo coming soon</span>
            </div>
          )
        }
      </div>

      <div class="details-column">
        <p class="pepper-label">Pepper variety</p>

        <h1>{pepper.data.name}</h1>

        <p class="description">
          {pepper.data.description}
        </p>

        <div class="facts">
          <div class="fact-row">
            <span>Species</span>
            <strong>{pepper.data.species}</strong>
          </div>

          <div class="fact-row">
            <span>Heat</span>
            <strong>{pepper.data.heat}</strong>
          </div>

          {
            pepper.data.color && (
              <div class="fact-row">
                <span>Ripe color</span>
                <strong>{pepper.data.color}</strong>
              </div>
            )
          }
        </div>

        <div class="seed-card-wrap">
          <SeedCard
            productId={pepper.id}
            collection="peppers"
            name={pepper.data.name}
            available={pepper.data.available}
            seedPrice={pepper.data.seedPrice}
            seedQuantity={pepper.data.seedQuantity}
            isolatedAvailable={pepper.data.isolatedAvailable}
            isolatedPrice={pepper.data.isolatedPrice}
            purchaseUrl={pepper.data.purchaseUrl}
          />
        </div>
      </div>
    </section>

    <section class="body-content">
      <Content />
    </section>
  </main>
</MainLayout>
<div id="image-lightbox" class="image-lightbox">
  <button
    id="lightbox-close"
    class="lightbox-close"
    type="button"
    aria-label="Close image"
  >
    ×
  </button>

  <img id="lightbox-image" src="" alt="" />
</div>

<script>
  const mainImage = document.getElementById("main-pepper-image");
  const lightbox = document.getElementById("image-lightbox");
  const lightboxImage = document.getElementById("lightbox-image");
  const closeButton = document.getElementById("lightbox-close");

  function openLightbox() {
    if (
      !(mainImage instanceof HTMLImageElement) ||
      !(lightbox instanceof HTMLElement) ||
      !(lightboxImage instanceof HTMLImageElement)
    ) {
      return;
    }

    lightboxImage.src = mainImage.src;
    lightboxImage.alt = mainImage.alt;

    lightbox.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    if (!(lightbox instanceof HTMLElement)) return;

    lightbox.classList.remove("open");
    document.body.style.overflow = "";
  }

  mainImage?.addEventListener("click", openLightbox);
  closeButton?.addEventListener("click", closeLightbox);

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeLightbox();
    }
  });
</script>
<script>
  const mainImage = document.querySelector(
    "#main-pepper-image",
  ) as HTMLImageElement | null;

  const captionElement = document.querySelector(
    "#image-caption",
  ) as HTMLElement | null;

  const thumbnailButtons =
    document.querySelectorAll<HTMLButtonElement>(
      ".thumbnail-button",
    );

  thumbnailButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedImage = button.dataset.image;
      const selectedCaption = button.dataset.caption ?? "";

      if (!mainImage || !selectedImage) {
        return;
      }

      mainImage.src = selectedImage;
      mainImage.alt = selectedCaption || "Pepper image";

      if (captionElement) {
        captionElement.textContent = selectedCaption;
        captionElement.classList.toggle(
          "empty",
          selectedCaption.length === 0,
        );
      }

      thumbnailButtons.forEach((thumbnail) => {
        thumbnail.classList.remove("active");
      });

      button.classList.add("active");
    });
  });
</script>

<style>
  .pepper-page {
    width: min(1180px, calc(100% - 40px));
    margin: auto;
    padding: 48px 0 110px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    margin-bottom: 34px;
    color: var(--red);
    font-weight: 750;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .pepper-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    gap: 64px;
    align-items: start;
  }

  .image-column {
    min-width: 0;
  }

  .main-image-figure {
    margin: 0;
  }

  .detail-image {
    width: 100%;
    aspect-ratio: 4 / 4.6;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: #e8e2d4;
    box-shadow: 0 18px 45px rgba(50, 40, 25, 0.1);
  }

  .detail-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .image-caption {
    min-height: 22px;
    margin: 12px 8px 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
    text-align: center;
  }

  .image-caption.empty {
    visibility: hidden;
  }

  .image-placeholder {
    display: grid;
    place-items: center;
    color: var(--muted);
  }

  .thumbnail-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-top: 12px;
  }

  .thumbnail-button {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    padding: 0;
    cursor: pointer;
    border: 2px solid transparent;
    border-radius: 10px;
    background: #e8e2d4;
    opacity: 0.72;
    transition:
      opacity 150ms ease,
      border-color 150ms ease,
      transform 150ms ease;
  }

  .thumbnail-button:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .thumbnail-button.active {
    border-color: var(--red);
    opacity: 1;
  }

  .thumbnail-button img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .details-column {
    position: sticky;
    top: 30px;
    padding-top: 6px;
  }

  .pepper-label {
    margin: 0 0 10px;
    color: var(--red);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .details-column h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(50px, 6vw, 84px);
    line-height: 0.96;
    letter-spacing: -0.05em;
  }

  .description {
    max-width: 620px;
    margin: 26px 0 30px;
    color: var(--text);
    font-size: 20px;
    line-height: 1.62;
  }

  .facts {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.5);
  }

  .fact-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 28px;
    padding: 17px 20px;
  }

  .fact-row + .fact-row {
    border-top: 1px solid var(--border);
  }

  .fact-row span {
    color: var(--muted);
  }

  .fact-row strong {
    text-align: right;
  }

  .seed-card-wrap {
    margin-top: 22px;
  }

  .body-content {
    max-width: 760px;
    margin-top: 72px;
    padding-top: 38px;
    border-top: 1px solid var(--border);
    font-size: 18px;
    line-height: 1.8;
  }

  .body-content:empty {
    display: none;
  }

  @media (max-width: 850px) {
    .pepper-page {
      padding-top: 34px;
    }

    .pepper-hero {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .details-column {
      position: static;
      padding-top: 0;
    }

    .details-column h1 {
      font-size: clamp(46px, 13vw, 74px);
    }

    .detail-image {
      aspect-ratio: 4 / 4.2;
    }

    .body-content {
      margin-top: 54px;
    }
  }

  @media (max-width: 520px) {
    .pepper-page {
      width: min(100% - 28px, 1180px);
    }

    .thumbnail-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .fact-row {
      align-items: flex-start;
    }

    .fact-row strong {
      max-width: 62%;
    }
  }
  .clickable-main-image {
  cursor: zoom-in;
}

.image-lightbox {
  position: fixed;
  inset: 0;
  z-index: 9999;

  display: none;
  align-items: center;
  justify-content: center;

  padding: 30px;

  background: rgba(0, 0, 0, 0.92);
}

.image-lightbox.open {
  display: flex;
}

.image-lightbox img {
  max-width: 95vw;
  max-height: 92vh;

  width: auto;
  height: auto;

  object-fit: contain;
  border-radius: 8px;
}

.lightbox-close {
  position: absolute;
  top: 20px;
  right: 30px;

  border: none;
  background: transparent;
  color: white;

  font-size: 42px;
  line-height: 1;

  cursor: pointer;
}
</style>
