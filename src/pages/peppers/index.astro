---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

const peppers = await getCollection(
  "peppers",
  ({ data }) => data.showOnWebsite,
);

const sortedPeppers = [...peppers].sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

const speciesOptions = [
  ...new Set(sortedPeppers.map((pepper) => pepper.data.species).filter(Boolean)),
].sort();

function getMaxShu(heat: string | undefined) {
  if (!heat) return 0;
  const numbers = heat.match(/[\d,]+/g);
  if (!numbers?.length) return 0;
  return Math.max(...numbers.map((number) => Number(number.replaceAll(",", ""))));
}

function getHeatBand(heat: string | undefined) {
  const shu = getMaxShu(heat);
  if (shu <= 2500) return "mild";
  if (shu <= 50000) return "medium";
  if (shu <= 350000) return "hot";
  return "superhot";
}

/*
Converts heat text such as "25,000–50,000 SHU" into a visual percentage.

The stepped, logarithmic scale keeps mild peppers readable without making
medium-hot varieties feel hotter than they are.
*/
function getHeatPercentage(heat: string | undefined) {
  const shu = getMaxShu(heat);

  if (shu <= 500) return 4;
  if (shu <= 2500) return 9;
  if (shu <= 5000) return 16;
  if (shu <= 15000) return 25;
  if (shu <= 30000) return 32;
  if (shu <= 50000) return 38;
  if (shu <= 100000) return 48;
  if (shu <= 250000) return 61;
  if (shu <= 500000) return 73;
  if (shu <= 1000000) return 86;

  return 100;
}
---

<MainLayout title="Pepper Varieties | Red Hot Philly Peppers">
  <main class="catalog-page">
    <header class="catalog-header">
      <p class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        Peppers
      </p>

      <h1>Pepper Varieties</h1>
      <p class="catalog-description">
        Explore our current seed collection, from nearly sweet to seriously hot.
        SHU ranges are estimates; growing conditions and individual pods can vary.
      </p>
    </header>

    {
      sortedPeppers.length > 0 ? (
        <>
          <section class="catalog-filters" aria-label="Filter pepper varieties">
            <div class="filter-field">
              <label for="heat-filter">Heat level</label>
              <select id="heat-filter">
                <option value="all">All heat levels</option>
                <option value="mild">Mild · 0–2,500 SHU</option>
                <option value="medium">Medium · 2,501–50,000 SHU</option>
                <option value="hot">Hot · 50,001–350,000 SHU</option>
                <option value="superhot">Superhot · 350,000+ SHU</option>
              </select>
            </div>

            <div class="filter-field">
              <label for="species-filter">Species</label>
              <select id="species-filter">
                <option value="all">All species</option>
                {speciesOptions.map((species) => (
                  <option value={species}>{species}</option>
                ))}
              </select>
            </div>

            <button
              id="availability-filter"
              class="filter-chip"
              type="button"
              aria-pressed="false"
            >
              <span class="filter-chip-dot" aria-hidden="true"></span>
              Available now
            </button>
            <button id="reset-filters" type="button">Reset filters</button>
            <p id="filter-count" aria-live="polite">
              Showing {sortedPeppers.length} {sortedPeppers.length === 1 ? "variety" : "varieties"}
            </p>
          </section>

          <section class="variety-grid" aria-label="Pepper varieties">
          {sortedPeppers.map((pepper) => {
            const heatPercentage = getHeatPercentage(pepper.data.heat);

            return (
              <article
                class="variety-card"
                data-heat-band={getHeatBand(pepper.data.heat)}
                data-species={pepper.data.species}
                data-available={String(pepper.data.available)}
              >
                <a
                  class="image-link"
                  href={`/peppers/${pepper.id}`}
                  aria-label={`View ${pepper.data.name}`}
                >
                  {pepper.data.image ? (
                    <img
                      src={pepper.data.image}
                      alt={`${pepper.data.name} pepper`}
                      loading="lazy"
                    />
                  ) : (
                    <div class="image-placeholder">
                      <span>Photo coming soon</span>
                    </div>
                  )}
                </a>

                <div class="pepper-card-content">
                  <div class="card-heading">
                    <h2>
                      <a href={`/peppers/${pepper.id}`}>
                        {pepper.data.name}
                      </a>
                    </h2>

                    {pepper.data.available && (
                      <span class="availability">Seeds available</span>
                    )}
                  </div>

                  <p class="species">{pepper.data.species}</p>

                  <div class="heat-section">
                    <div class="heat-heading">
                      <span>
                        <b class={`heat-band heat-band-${getHeatBand(pepper.data.heat)}`}>
                          {getHeatBand(pepper.data.heat).replace("-", " ")}
                        </b>
                      </span>
                      <strong>{pepper.data.heat}</strong>
                    </div>

                    <div
                      class="heat-track"
                      role="meter"
                      aria-label={`${pepper.data.name} heat level`}
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-valuenow={Math.round(heatPercentage)}
                    >
                      <span
                        class="heat-fill"
                        style={`width: ${heatPercentage}%`}
                      />
                    </div>
                  </div>

                  <a class="view-link" href={`/peppers/${pepper.id}`}>
                    View variety →
                  </a>
                </div>
              </article>
            );
          })}
          </section>
          <p id="no-filter-results" class="no-filter-results" hidden>
            No varieties match those filters.
          </p>
        </>
      ) : (
        <p class="empty-message">Pepper varieties are coming soon.</p>
      )
    }
  </main>
</MainLayout>

<script>
  const heatFilter = document.querySelector<HTMLSelectElement>("#heat-filter");
  const speciesFilter = document.querySelector<HTMLSelectElement>("#species-filter");
  const availabilityFilter = document.querySelector<HTMLButtonElement>("#availability-filter");
  const resetButton = document.querySelector<HTMLButtonElement>("#reset-filters");
  const countLabel = document.querySelector<HTMLElement>("#filter-count");
  const noResults = document.querySelector<HTMLElement>("#no-filter-results");
  const varietyCards = [...document.querySelectorAll<HTMLElement>(".variety-card")];

  function applyFilters() {
    const selectedHeat = heatFilter?.value ?? "all";
    const selectedSpecies = speciesFilter?.value ?? "all";
    const availableOnly = availabilityFilter?.getAttribute("aria-pressed") === "true";
    let visibleCount = 0;

    varietyCards.forEach((card) => {
      const matchesHeat = selectedHeat === "all" || card.dataset.heatBand === selectedHeat;
      const matchesSpecies = selectedSpecies === "all" || card.dataset.species === selectedSpecies;
      const matchesAvailability = !availableOnly || card.dataset.available === "true";
      const isVisible = matchesHeat && matchesSpecies && matchesAvailability;
      card.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });

    if (countLabel) {
      countLabel.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? "variety" : "varieties"}`;
    }
    if (noResults) noResults.hidden = visibleCount !== 0;
  }

  heatFilter?.addEventListener("change", applyFilters);
  speciesFilter?.addEventListener("change", applyFilters);
  availabilityFilter?.addEventListener("click", () => {
    const isPressed = availabilityFilter.getAttribute("aria-pressed") === "true";
    availabilityFilter.setAttribute("aria-pressed", String(!isPressed));
    applyFilters();
  });
  resetButton?.addEventListener("click", () => {
    if (heatFilter) heatFilter.value = "all";
    if (speciesFilter) speciesFilter.value = "all";
    availabilityFilter?.setAttribute("aria-pressed", "false");
    applyFilters();
  });
</script>

<style>
  .catalog-page {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 54px 0 110px;
  }

  .catalog-header {
    max-width: 760px;
    margin-bottom: 44px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 38px;
    color: var(--muted);
    font-size: 14px;
  }

  .breadcrumb a {
    color: var(--black);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--red);
  }

  .catalog-header h1 {
    margin: 0;
    font-size: clamp(52px, 8vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .catalog-description {
    max-width: 680px;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 20px;
    line-height: 1.65;
  }

  .catalog-filters {
    margin-bottom: 26px;
    padding: 18px;
    display: flex;
    align-items: end;
    gap: 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.42);
  }

  .filter-field {
    min-width: 190px;
    display: grid;
    gap: 7px;
  }

  .filter-field label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .filter-field select,
  .filter-chip,
  #reset-filters {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--white);
    color: var(--black);
    font: inherit;
    font-size: 14px;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    font-weight: 800;
    white-space: nowrap;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
  }

  .filter-chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #56a56f;
    box-shadow: 0 0 0 3px rgba(86, 165, 111, 0.14);
  }

  .filter-chip[aria-pressed="true"] {
    border-color: #397d4e;
    background: #397d4e;
    color: var(--white);
  }

  .filter-chip[aria-pressed="true"] .filter-chip-dot {
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.2);
  }

  .filter-chip:focus-visible {
    outline: 3px solid rgba(57, 125, 78, 0.3);
    outline-offset: 2px;
  }

  #reset-filters {
    cursor: pointer;
    color: var(--red-dark);
    font-weight: 800;
  }

  #filter-count {
    margin: 0 0 12px auto;
    color: var(--muted);
    font-size: 13px;
  }

  .no-filter-results {
    margin: 32px 0 0;
    color: var(--muted);
    font-size: 17px;
  }

  .variety-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding-top: 34px;
    border-top: 1px solid var(--border);
  }

 .variety-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.52);
  box-shadow: 0 12px 32px rgba(50, 40, 25, 0.06);
  transition:
    transform 160ms ease,
    box-shadow 160ms ease;
}

  .variety-card[hidden] {
    display: none;
  }

  .variety-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(50, 40, 25, 0.1);
  }

  .image-link {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #e8e2d4;
  }

  .image-link img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  padding: 12px;
  background: #f7f2ed;
  transition: transform 220ms ease;
}

  .variety-card:hover .image-link img {
    transform: scale(1.025);
  }

  .image-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: var(--muted);
    font-size: 14px;
  }

  /*
  Unique class name prevents MainLayout's global .card-content rules
  from creating the large blank space.
  */
  .pepper-card-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 22px;
}

  .card-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
  }

  .card-heading h2 {
  margin: 0;
  font-size: 23px;
  line-height: 1.12;
  letter-spacing: -0.025em;

  /* Reserve space for two lines */
  min-height: 2.24em;
}

  .card-heading h2 a {
    color: var(--black);
    text-decoration: none;
  }

  .card-heading h2 a:hover {
    color: var(--red);
  }

  .availability {
    flex: 0 0 auto;
    padding: 6px 8px;
    border-radius: 999px;
    color: #225334;
    background: #dcebdc;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .species {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 14px;
    font-style: italic;
  }

  .heat-section {
    margin-top: 20px;
  }

  .heat-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .heat-heading span {
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .heat-heading span:first-child {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .heat-band {
    padding: 4px 7px;
    border-radius: 999px;
    background: var(--red-pale);
    color: var(--red-dark);
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .heat-band-mild { background: #e2edda; color: #365b2b; }
  .heat-band-medium { background: #f3e7c7; color: #735515; }
  .heat-band-hot { background: #f2d4c7; color: #8a321d; }
  .heat-band-superhot { background: #edd0d0; color: #7f1d1d; }

  .heat-heading strong {
    color: var(--red);
    font-size: 13px;
    font-weight: 850;
    text-align: right;
  }

  .heat-track {
    width: 100%;
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(181, 43, 43, 0.12);
  }

  .heat-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      #e4a33c 0%,
      var(--red-light) 55%,
      var(--red-dark) 100%
    );
  }

.view-link {
  margin-top: 24px;
  color: var(--red);
  font-size: 14px;
  font-weight: 800;
  text-decoration: none;
}

  .view-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .empty-message {
    padding-top: 34px;
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .variety-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .catalog-page {
      width: min(100% - 28px, 1180px);
      padding-top: 34px;
    }

    .catalog-header {
      margin-bottom: 32px;
    }

    .breadcrumb {
      margin-bottom: 28px;
    }

    .catalog-header h1 {
      font-size: clamp(48px, 16vw, 68px);
    }

    .catalog-description {
      font-size: 18px;
    }

    .variety-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .catalog-filters {
      align-items: stretch;
      flex-direction: column;
    }

    .filter-field {
      min-width: 0;
    }

    #filter-count {
      margin: 4px 0 0;
    }
  }
</style>
